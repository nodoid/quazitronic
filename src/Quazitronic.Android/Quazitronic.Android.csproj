<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>Quazitronic.Android</RootNamespace>
    <AssemblyName>Orictron</AssemblyName>
    <ApplicationId>uk.co.allthejohnsons.quazitronic</ApplicationId>
    <ApplicationTitle>Orictron</ApplicationTitle>
    <ApplicationVersion>$(OrictronBuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(OrictronVersion)</ApplicationDisplayVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <!-- Release signing: supply via build/build-release.sh (reads signing/android.properties). -->
  <PropertyGroup Condition="'$(AndroidSigningKeyStore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Quazitronic.Core\Quazitronic.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
