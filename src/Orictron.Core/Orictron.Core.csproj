<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Orictron</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time reference only; each platform head supplies its own MonoGame runtime. -->
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orictron.Tests" />
    <InternalsVisibleTo Include="Orictron.Capture" />
  </ItemGroup>
</Project>
